{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "animation-timeline",
          "animation-timeline: view(700px 10px)"
        ]
      }
    ],
    "detect-css-reflows/composite": "off"
  }
}